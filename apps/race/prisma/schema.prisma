generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RacerStatus {
  NOT_STARTED
  ON_ROUTE
  FINISHED
  DNF
}

enum RaceEventType {
  RACER_IMPORTED
  RACER_STARTED
  CHECKPOINT_REACHED
  PHOTO_UPLOADED
  RACER_FINISHED
  RACER_DNF
  SMS_SENT
  SMS_FAILED
  ADMIN_NOTE
}

enum PhotoType {
  CHECKPOINT
  FREE
}

enum SmsProvider {
  MOCK
  BULKGATE
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Race {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  year        Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  racers      Racer[]
  checkpoints Checkpoint[]
  events      RaceEvent[]
  photos      RacerPhoto[]

  @@unique([year, name])
}

model Racer {
  id                 String           @id @default(uuid()) @db.Uuid
  raceId             String           @db.Uuid
  race               Race             @relation(fields: [raceId], references: [id], onDelete: Cascade)
  startNumber        String?
  firstName          String
  lastName           String
  email              String?
  phone              String?
  routeName          String?
  paymentStatus      String?
  registrationStatus String?
  dog1Name           String?
  dog1BirthDate      String?
  dog1Breed          String?
  dog2Name           String?
  dog2BirthDate      String?
  dog2Breed          String?
  dog3Name           String?
  dog3BirthDate      String?
  dog3Breed          String?
  publicAccessToken  String           @unique
  importedFrom       String?
  importedSourceKey  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  state              RacerRaceState?
  events             RaceEvent[]
  photos             RacerPhoto[]
  smsMessages        SmsMessage[]

  @@index([raceId])
  @@index([raceId, email])
  @@index([raceId, phone])
}

model Checkpoint {
  id         String       @id @default(uuid()) @db.Uuid
  raceId     String       @db.Uuid
  race       Race         @relation(fields: [raceId], references: [id], onDelete: Cascade)
  name       String
  order      Int
  distanceKm Float
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  events     RaceEvent[]
  photos     RacerPhoto[]

  @@unique([raceId, order])
  @@index([raceId])
}

model RaceEvent {
  id           String        @id @default(uuid()) @db.Uuid
  raceId       String        @db.Uuid
  race         Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)
  racerId      String?       @db.Uuid
  racer        Racer?        @relation(fields: [racerId], references: [id], onDelete: Cascade)
  checkpointId String?       @db.Uuid
  checkpoint   Checkpoint?   @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  type         RaceEventType
  payload      Json?
  createdAt    DateTime      @default(now())

  @@index([raceId, createdAt])
  @@index([racerId, createdAt])
  @@index([checkpointId, createdAt])
}

model RacerRaceState {
  id                 String       @id @default(uuid()) @db.Uuid
  raceId             String       @db.Uuid
  racerId            String       @unique @db.Uuid
  racer              Racer        @relation(fields: [racerId], references: [id], onDelete: Cascade)
  status             RacerStatus  @default(NOT_STARTED)
  lastCheckpointId   String?      @db.Uuid
  lastCheckpointKm   Float?
  currentSegmentFrom String?      @db.Uuid
  currentSegmentTo   String?      @db.Uuid
  lastActivityAt     DateTime?
  photoCount         Int          @default(0)
  updatedAt          DateTime     @updatedAt

  @@index([raceId, status])
  @@index([currentSegmentFrom, currentSegmentTo])
}

model RacerPhoto {
  id               String      @id @default(uuid()) @db.Uuid
  raceId           String      @db.Uuid
  race             Race        @relation(fields: [raceId], references: [id], onDelete: Cascade)
  racerId          String      @db.Uuid
  racer            Racer       @relation(fields: [racerId], references: [id], onDelete: Cascade)
  checkpointId     String?     @db.Uuid
  checkpoint       Checkpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  type             PhotoType
  bucket           String
  objectKey        String
  originalFileName String?
  mimeType         String
  sizeBytes        Int
  caption          String?
  createdAt        DateTime    @default(now())

  @@index([raceId, createdAt])
  @@index([racerId, createdAt])
}

model SmsMessage {
  id         String      @id @default(uuid()) @db.Uuid
  raceId     String      @db.Uuid
  racerId    String?     @db.Uuid
  racer      Racer?      @relation(fields: [racerId], references: [id], onDelete: SetNull)
  provider   SmsProvider
  phone      String
  body       String
  status     String
  providerId String?
  error      String?
  createdAt  DateTime    @default(now())

  @@index([raceId, createdAt])
}
